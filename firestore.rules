rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(spaceId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.members;
    }

    // 自分の所属リストIDだけを持つ
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 招待コード → リストID。コードを知っている人だけが1件ずつ引ける（一覧取得は不可）
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if isMember(request.resource.data.spaceId);
    }

    match /spaces/{spaceId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        // メンバーはメンバー構成以外を編集できる
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        // 招待された人は、1人だけのリストに自分を追加することだけできる
        || (resource.data.members.size() == 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
      );

      match /members/{uid} {
        allow read: if isMember(spaceId);
        allow write: if isMember(spaceId) && request.auth.uid == uid;
      }

      match /{collection}/{docId} {
        allow read, write: if isMember(spaceId) && collection in ['items', 'photos'];
      }
    }
  }
}
